generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Runtime bağlantısı (S16-7): PgBouncer kullanılırsa pooler endpoint'i + ?pgbouncer=true.
  url       = env("DATABASE_URL")
  // Migration/introspection doğrudan DB'ye gider (pooler transaction-mode bazı DDL'leri
  // desteklemez). PgBouncer yoksa DIRECT_URL = DATABASE_URL olur (start komutunda
  // varsayılan) → mevcut davranış korunur.
  directUrl = env("DIRECT_URL")
}

// ─── Core ────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  googleId     String?  @unique @map("google_id")
  email        String   @unique
  displayName  String   @map("display_name")
  photoUrl     String?  @map("photo_url")
  fcmToken     String?  @map("fcm_token")
  passwordHash String?  @map("password_hash")
  authProvider String   @default("google") @map("auth_provider")
  role         UserRole @default(USER)
  isSuspended  Boolean  @default(false) @map("is_suspended")

  // Profile
  bio              String?  @db.Text
  city             String?
  favoriteCuisines String[] @map("favorite_cuisines")
  isPublic         Boolean  @default(true) @map("is_public")

  // Gamification — denormalized for fast reads
  starCount Int @default(0) @map("star_count")

  // Email verification (email/password auth)
  emailVerified           Boolean   @default(false) @map("email_verified")
  emailVerificationToken  String?   @unique @map("email_verification_token")
  emailVerificationExpiry DateTime? @map("email_verification_expiry")
  passwordResetToken      String?   @unique @map("password_reset_token")
  passwordResetExpiry     DateTime? @map("password_reset_expiry")

  // AI Recommender — arkadaşlarla tercih paylaşımı (opt-in)
  shareWithFriendsRecommender Boolean @default(false) @map("share_with_friends_recommender")

  // Referral
  referralCode    String? @unique @map("referral_code")
  referralApplied Boolean @default(false) @map("referral_applied")

  lastLoginAt DateTime? @map("last_login_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // Relations
  subscription            Subscription?
  favorites               Favorite[]
  reviews                 Review[]
  sentFriendRequests      FriendRequest[]          @relation("SentRequests")
  receivedFriendRequests  FriendRequest[]          @relation("ReceivedRequests")
  sentRecommendations     Recommendation[]         @relation("SentRecommendations")
  receivedRecommendations Recommendation[]         @relation("ReceivedRecommendations")
  starEvents              StarEvent[]
  userRewards             UserReward[]
  collections             Collection[]
  sharedCollections       CollectionShare[]        @relation("SharedCollections")
  restaurantProfile       RestaurantProfile?
  notifications           Notification[]
  sentMessages            Message[]                @relation("SentMessages")
  receivedMessages        Message[]                @relation("ReceivedMessages")
  givenReports            UserReport[]             @relation("ReportsGiven")
  receivedReports         UserReport[]             @relation("ReportsReceived")
  reservations            Reservation[]
  logs                    UserLog[]
  mealGroupsCreated       MealGroup[]              @relation("MealGroupCreator")
  mealGroupMembers        MealGroupMember[]        @relation("MealGroupMemberships")
  pollsCreated            RestaurantPoll[]         @relation("PollsCreated")
  pollVotes               PollVote[]               @relation("PollVotes")
  aiRecommendationLogs    AiRecommendationLog[]
  recommendationFeedbacks RecommendationFeedback[]
  activityEvents          ActivityEvent[]
  feedbackPreference      FeedbackPreference?
  searchHistory           SearchHistory[]
  checkIns                CheckIn[]
  diaryEntries            DiaryEntry[]
  notificationPreferences NotificationPreference[]
  placeRequests           PlaceRequest[]
  placeViews              PlaceView[]

  @@map("users")
}

// ─── Existing ────────────────────────────────────────────────────────────────

model Subscription {
  id                 String             @id @default(uuid())
  userId             String             @unique @map("user_id")
  planType           PlanType           @map("plan_type")
  status             SubscriptionStatus
  startedAt          DateTime           @map("started_at")
  expiresAt          DateTime           @map("expires_at")
  storeTransactionId String?            @unique @map("store_transaction_id")
  createdAt          DateTime           @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

// S14-B4: Append-only IAP satın alma defteri (denetim/suistimal/muhasebe/destek).
// Her doğrulama (android/appstore) ve RTDN olayı bir satır yazar; başarı + reddedilen.
// Token ham değil HASH'li (sızıntı riski). User FK YOK — RTDN'de userId olmayabilir.
model PurchaseEvent {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  source     String   // 'android' | 'appstore' | 'rtdn'
  type       String   // olay/bildirim türü (örn. 'verify', notificationType)
  productId  String?  @map("product_id")
  tokenHash  String?  @map("token_hash")
  status     String   // 'verified' | 'reuse_rejected' | 'account_mismatch' | 'blocked' | 'renewed' | 'expired' | 'cancelled' ...
  rawPayload Json?    @map("raw_payload")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([tokenHash])
  @@map("purchase_events")
}

model Favorite {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  placeId       String   @map("place_id")
  placeName     String   @map("place_name")
  placeAddress  String?  @map("place_address")
  placeLat      Decimal  @map("place_lat") @db.Decimal(10, 7)
  placeLng      Decimal  @map("place_lng") @db.Decimal(10, 7)
  placePhone    String?  @map("place_phone")
  placePhotoUrl String?  @map("place_photo_url")
  placeRating   Decimal? @map("place_rating") @db.Decimal(3, 1)
  createdAt     DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, placeId])
  @@index([placeId])
  @@map("favorites")
}

model Review {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  placeId   String   @map("place_id")
  rating    Int      @db.SmallInt
  body      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  reply ReviewReply?

  @@unique([userId, placeId])
  @@index([placeId])
  @@map("reviews")
}

// ─── Social ───────────────────────────────────────────────────────────────────

/// Arkadaşlık istekleri ve onaylanmış arkadaşlıklar.
/// status=PENDING → istek gönderildi
/// status=ACCEPTED → arkadaşlar
/// status=REJECTED → reddedildi
model FriendRequest {
  id         String              @id @default(uuid())
  fromUserId String              @map("from_user_id")
  toUserId   String              @map("to_user_id")
  status     FriendRequestStatus @default(PENDING)
  note       String?             @db.VarChar(300)
  createdAt  DateTime            @default(now()) @map("created_at")
  updatedAt  DateTime            @updatedAt @map("updated_at")

  fromUser User @relation("SentRequests", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("ReceivedRequests", fields: [toUserId], references: [id], onDelete: Cascade)

  // Bir kullanıcı aynı kişiye birden fazla istek gönderemez
  @@unique([fromUserId, toUserId])
  @@index([toUserId, status])
  @@index([fromUserId, status])
  @@map("friend_requests")
}

/// Restoran önerileri.
/// toUserId=null → herkese açık (profilde görünür)
/// toUserId=X   → sadece X kullanıcısına özel mesaj
model Recommendation {
  id         String  @id @default(uuid())
  fromUserId String  @map("from_user_id")
  toUserId   String? @map("to_user_id")

  // Restoran snapshot — Google Places verisinin anlık kopyası
  placeId       String   @map("place_id")
  placeName     String   @map("place_name")
  placeAddress  String?  @map("place_address")
  placePhotoUrl String?  @map("place_photo_url")
  placeRating   Decimal? @map("place_rating") @db.Decimal(3, 1)
  placeTypes    String[] @map("place_types")

  message   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  fromUser User  @relation("SentRecommendations", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User? @relation("ReceivedRecommendations", fields: [toUserId], references: [id], onDelete: SetNull)

  @@index([fromUserId])
  @@index([fromUserId, createdAt])
  @@index([toUserId])
  @@index([placeId])
  @@map("recommendations")
}

// ─── Collections ─────────────────────────────────────────────────────────────

/// Kullanıcının oluşturduğu restoran listeleri/koleksiyonları (Premium özellik)
model Collection {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(300)
  isPublic    Boolean  @default(false) @map("is_public")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user   User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  items  CollectionItem[]
  shares CollectionShare[]

  @@index([userId])
  @@map("collections")
}

model CollectionItem {
  id            String   @id @default(uuid())
  collectionId  String   @map("collection_id")
  placeId       String   @map("place_id")
  placeName     String   @map("place_name")
  placeAddress  String?  @map("place_address")
  placePhotoUrl String?  @map("place_photo_url")
  placeRating   Decimal? @map("place_rating") @db.Decimal(3, 1)
  note          String?  @db.VarChar(200)
  addedAt       DateTime @default(now()) @map("added_at")

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([collectionId, placeId])
  @@index([collectionId])
  @@map("collection_items")
}

/// Koleksiyonu arkadaşlarla paylaşma tablosu
model CollectionShare {
  id           String   @id @default(uuid())
  collectionId String   @map("collection_id")
  sharedWithId String   @map("shared_with_id")
  createdAt    DateTime @default(now()) @map("created_at")

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  sharedWith User       @relation("SharedCollections", fields: [sharedWithId], references: [id], onDelete: Cascade)

  @@unique([collectionId, sharedWithId])
  @@index([sharedWithId])
  @@map("collection_shares")
}

// ─── Gamification ────────────────────────────────────────────────────────────

/// Kullanıcının yıldız kazandığı her olay bir kayıt oluşturur.
/// Bu tablo hem geçmişi hem de denetimi sağlar.
model StarEvent {
  id          String        @id @default(uuid())
  userId      String        @map("user_id")
  type        StarEventType
  amount      Int
  description String
  // Olayın kaynağına referans (review id, recommendation id vb.)
  referenceId String?       @map("reference_id")
  createdAt   DateTime      @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, type, referenceId])
  @@map("star_events")
}

/// Ödül tanımları — admin tarafından seed ile doldurulur.
model Reward {
  id            String     @id @default(uuid())
  name          String
  description   String     @db.Text
  requiredStars Int        @map("required_stars")
  type          RewardType
  icon          String
  sortOrder     Int        @default(0) @map("sort_order")

  userRewards UserReward[]

  @@map("rewards")
}

/// Kullanıcının kilidini açtığı ödüller.
model UserReward {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  rewardId   String   @map("reward_id")
  unlockedAt DateTime @default(now()) @map("unlocked_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  reward Reward @relation(fields: [rewardId], references: [id])

  // Bir ödül yalnızca bir kez açılabilir
  @@unique([userId, rewardId])
  @@map("user_rewards")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum PlanType {
  monthly
  yearly
  trial
}

enum SubscriptionStatus {
  active
  cancelled
  expired
  trial
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum StarEventType {
  REVIEW
  RECOMMENDATION
  FRIEND_ADDED
  RATING
  RESERVATION
  RESERVATION_ATTENDED
  REFERRAL
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
  COMPLETED
}

enum RewardType {
  BADGE
  GIFT
}

enum UserRole {
  USER
  RESTAURANT
  ADMIN
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─── Restaurant Accounts ─────────────────────────────────────────────────────

model RestaurantProfile {
  id     String @id @default(uuid())
  userId String @unique @map("user_id")

  // Business info
  businessName       String  @map("business_name")
  displayName        String? @map("display_name") // kullanıcıya gösterilen ad (boşsa Google adı)
  ownerName          String  @map("owner_name")
  taxNumber          String  @unique @map("tax_number")
  taxOffice          String  @map("tax_office")
  taxCertificateData String? @map("tax_certificate_data") @db.Text
  phone              String
  altPhone           String? @map("alt_phone") // alternatif iletişim numarası
  contactEmail       String  @map("contact_email")
  address            String
  businessCategory   String  @map("business_category")

  // Google Places link
  placeId       String? @map("place_id")
  placeName     String? @map("place_name")
  placeAddress  String? @map("place_address")
  placePhotoUrl String? @map("place_photo_url")

  // Approval
  status            ApprovalStatus @default(PENDING)
  rejectionReason   String?        @map("rejection_reason") @db.Text
  approvedAt        DateTime?      @map("approved_at")
  reviewedByAdminId String?        @map("reviewed_by_admin_id")

  // Extra info
  reservationUrl      String? @map("reservation_url")
  announcement        String? @db.VarChar(500)
  announcementActive  Boolean @default(false) @map("announcement_active")
  acceptsReservations Boolean @default(false) @map("accepts_reservations")

  // Opening hours (JSON: { monday: { open: "09:00", close: "22:00", closed: false }, ... })
  openingHours Json? @map("opening_hours")

  // Discount
  discountEnabled     Boolean   @default(false) @map("discount_enabled")
  discountPercent     Float?    @map("discount_percent")
  discountMinStars    Int?      @map("discount_min_stars")
  discountNote        String?   @map("discount_note") @db.VarChar(200)
  discountActiveUntil DateTime? @map("discount_active_until")

  // Anlık kampanya gönderimi rate limit (günde 1) — S5-3
  lastCampaignAt DateTime? @map("last_campaign_at")

  // Aynı saat dilimine maksimum rezervasyon sayısı (null = sınırsız) — S8-5
  tableCount Int? @map("table_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  menuItems     RestaurantMenu[]
  reviewReplies ReviewReply[]
  reservations  Reservation[]
  photos        RestaurantPhoto[]

  @@index([placeId])
  @@index([status])
  @@map("restaurant_profiles")
}

// Restoran sahibinin yönettiği foto galerileri — RESTAURANT (mekan) ve PRODUCT (ürün).
// Görseller S3'te tutulur; burada yalnızca public URL + sıra bilgisi saklanır (S10-2/S10-3).
enum RestaurantPhotoKind {
  RESTAURANT
  PRODUCT
}

model RestaurantPhoto {
  id                  String              @id @default(uuid())
  restaurantProfileId String              @map("restaurant_profile_id")
  kind                RestaurantPhotoKind
  url                 String
  sortOrder           Int                 @default(0) @map("sort_order")
  createdAt           DateTime            @default(now()) @map("created_at")

  restaurantProfile RestaurantProfile @relation(fields: [restaurantProfileId], references: [id], onDelete: Cascade)

  @@index([restaurantProfileId, kind])
  @@map("restaurant_photos")
}

model RestaurantMenu {
  id           String   @id @default(uuid())
  restaurantId String   @map("restaurant_id")
  data         String   @db.Text
  mimeType     String   @map("mime_type")
  fileName     String?  @map("file_name")
  sortOrder    Int      @default(0) @map("sort_order")
  uploadedAt   DateTime @default(now()) @map("uploaded_at")

  restaurant RestaurantProfile @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("restaurant_menu")
}

model ReviewReply {
  id           String   @id @default(uuid())
  restaurantId String   @map("restaurant_id")
  reviewId     String   @unique @map("review_id")
  content      String   @db.VarChar(500)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  restaurant RestaurantProfile @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  review     Review            @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@map("review_replies")
}

// ─── Messages ─────────────────────────────────────────────────────────────────

model Message {
  id         String   @id @default(uuid())
  senderId   String   @map("sender_id")
  receiverId String   @map("receiver_id")
  content    String   @db.VarChar(2000)
  isRead     Boolean  @default(false) @map("is_read")
  createdAt  DateTime @default(now()) @map("created_at")

  sender   User @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId, receiverId])
  @@index([receiverId, isRead])
  @@map("messages")
}

// ─── User Reports ──────────────────────────────────────────────────────────────

/// Kullanıcı şikayetleri
/// status=PENDING → inceleniyor
/// status=RESOLVED → işlem yapıldı
/// status=DISMISSED → geçersiz / reddedildi
model UserReport {
  id          String   @id @default(uuid())
  reporterId  String   @map("reporter_id")
  reportedId  String   @map("reported_id")
  reason      String   @db.VarChar(1000)
  status      String   @default("PENDING")
  actionTaken String?  @map("action_taken") @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  reporter User @relation("ReportsGiven", fields: [reporterId], references: [id], onDelete: Cascade)
  reported User @relation("ReportsReceived", fields: [reportedId], references: [id], onDelete: Cascade)

  @@index([reportedId, status])
  @@index([reporterId])
  @@map("user_reports")
}

// ─── Reservations ─────────────────────────────────────────────────────────────

model Reservation {
  id           String @id @default(uuid())
  userId       String @map("user_id")
  restaurantId String @map("restaurant_id")
  placeId      String @map("place_id")
  placeName    String @map("place_name")

  date            String // "2026-05-20" yerel tarih
  time            String // "19:30"
  guestCount      Int     @map("guest_count")
  occasion        String? @db.VarChar(100)
  specialRequests String? @map("special_requests") @db.VarChar(500)

  status          ReservationStatus @default(PENDING)
  rejectionReason String?           @map("rejection_reason") @db.VarChar(500)
  attended        Boolean? // null = belirlenmedi, true = geldi, false = gelmedi

  // 24h+ PENDING kaldığında restorana gönderilen escalation hatırlatması — idempotency (S5-1)
  pendingReminderSentAt DateTime? @map("pending_reminder_sent_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant RestaurantProfile    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  messages   ReservationMessage[]

  @@index([userId])
  @@index([restaurantId, status])
  @@index([placeId])
  @@map("reservations")
}

model ReservationMessage {
  id            String   @id @default(uuid())
  reservationId String   @map("reservation_id")
  senderId      String   @map("sender_id")
  senderRole    String   @map("sender_role") // "USER" | "RESTAURANT"
  content       String   @db.VarChar(1000)
  createdAt     DateTime @default(now()) @map("created_at")

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId])
  @@map("reservation_messages")
}

// ─── User Activity Logs ───────────────────────────────────────────────────────

model UserLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  username  String?
  email     String?
  page      String
  action    String
  details   String?  @db.VarChar(500)
  ip        String?
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([email])
  @@index([createdAt])
  @@map("user_logs")
}

/// Sosyal aktivite akışı olayı (Sprint-4 Task #4).
/// type: REVIEW | FAVORITE | RESERVATION | RECOMMENDATION
/// placeId Google Places ID (string); metadata olaya özgü ek bilgi (örn. placeName).
/// Feed sorgusu: arkadaş id'leri IN + createdAt >= 7 gün → (userId, createdAt) indexi.
model ActivityEvent {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  type      String
  placeId   String?  @map("place_id")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("activity_events")
}

// ─── Meal Groups ─────────────────────────────────────────────────────────────

/// Arkadaşlar arası yemek planı grubu
model MealGroup {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(100)
  creatorId String   @map("creator_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  creator User              @relation("MealGroupCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  members MealGroupMember[]
  polls   RestaurantPoll[]

  @@index([creatorId])
  @@map("meal_groups")
}

model MealGroupMember {
  id        String   @id @default(uuid())
  groupId   String   @map("group_id")
  userId    String   @map("user_id")
  status    String   @default("INVITED") // INVITED | ACCEPTED | DECLINED
  createdAt DateTime @default(now()) @map("created_at")

  group MealGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User      @relation("MealGroupMemberships", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId, status])
  @@map("meal_group_members")
}

/// Grup içi restoran anketi
model RestaurantPoll {
  id        String    @id @default(uuid())
  groupId   String    @map("group_id")
  creatorId String    @map("creator_id")
  question  String?   @db.VarChar(300)
  status    String    @default("OPEN") // OPEN | CLOSED
  createdAt DateTime  @default(now()) @map("created_at")
  closedAt  DateTime? @map("closed_at")

  group   MealGroup    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  creator User         @relation("PollsCreated", fields: [creatorId], references: [id], onDelete: Cascade)
  options PollOption[]

  @@index([groupId, status])
  @@map("restaurant_polls")
}

model PollOption {
  id            String   @id @default(uuid())
  pollId        String   @map("poll_id")
  placeId       String   @map("place_id")
  placeName     String   @map("place_name")
  placeAddress  String?  @map("place_address")
  placePhotoUrl String?  @map("place_photo_url")
  placeRating   Decimal? @map("place_rating") @db.Decimal(3, 1)
  addedAt       DateTime @default(now()) @map("added_at")

  poll  RestaurantPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes PollVote[]

  @@unique([pollId, placeId])
  @@index([pollId])
  @@map("poll_options")
}

model PollVote {
  id        String   @id @default(uuid())
  optionId  String   @map("option_id")
  userId    String   @map("user_id")
  vote      String // YES | NO | MAYBE
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user   User       @relation("PollVotes", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([optionId, userId])
  @@index([userId])
  @@map("poll_votes")
}

// ─── AI Recommender ───────────────────────────────────────────────────────────

/// Claude API'ye gönderilen her AI öneri çağrısı burada loglanır.
/// Audit, free-tier rate limit sayımı ve token maliyet izleme için kullanılır.
/// placeId'ler Google Places ID'leri (string), Restaurant tablosu yok.
model AiRecommendationLog {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  requestedAt       DateTime @default(now()) @map("requested_at")
  model             String // "claude-haiku-4-5-20251001" | "claude-sonnet-4-6"
  candidatePlaceIds String[] @map("candidate_place_ids")
  suggestedPlaceIds String[] @map("suggested_place_ids")
  promptTokens      Int      @default(0) @map("prompt_tokens")
  completionTokens  Int      @default(0) @map("completion_tokens")
  cachedTokens      Int      @default(0) @map("cached_tokens")
  latencyMs         Int      @default(0) @map("latency_ms")
  mood              String?  @db.VarChar(50)
  lat               Float?
  lng               Float?
  responseJson      Json?    @map("response_json")

  user      User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  feedbacks RecommendationFeedback[]

  @@index([userId, requestedAt])
  @@map("ai_recommendation_logs")
}

/// Kullanıcının AI öneri sonrası verdiği 👍/👎 feedback.
/// Sprint-2 Task #4 — öneri kalitesi ölçümü + gelecek sprint'te iyileştirme sinyali.
model RecommendationFeedback {
  id                    String   @id @default(uuid())
  userId                String   @map("user_id")
  aiRecommendationLogId String?  @map("ai_recommendation_log_id")
  placeId               String   @map("place_id")
  sentiment             String // 'positive' | 'negative'
  comment               String?  @db.VarChar(500)
  visited               Boolean  @default(false)
  // Geri bildirilen mekanın Google place types'ı — mutfak tipi aggregate'i için (S4-7)
  placeTypes            String[] @default([]) @map("place_types")
  createdAt             DateTime @default(now()) @map("created_at")

  user     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  aiRecLog AiRecommendationLog? @relation(fields: [aiRecommendationLogId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([aiRecommendationLogId])
  @@index([placeId, sentiment])
  @@map("recommendation_feedback")
}

/// Kişisel yemek günlüğü (Sprint-7 #93).
/// Kullanıcının kendine özel ziyaret kaydı: tarih + not + isim/foto/types snapshot.
/// Sadece sahibi görür (collection paylaşımı YOK). Aynı mekana birden çok kez
/// gidebileceği için CollectionItem'in unique kısıtından bağımsız ayrı model.
/// Stats endpoint'i types snapshot'ından mutfak etiketlerini agregeler.
model DiaryEntry {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  placeId       String   @map("place_id")
  placeName     String   @map("place_name")
  placePhotoUrl String?  @map("place_photo_url")
  placeTypes    String[] @default([]) @map("place_types")
  visitedAt     DateTime @default(now()) @map("visited_at")
  note          String?  @db.VarChar(500)
  createdAt     DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, visitedAt])
  @@map("diary_entries")
}

/// Kullanıcının bildirim tercihleri (Sprint-8 #100).
/// Opt-out modeli: kayıt yoksa bildirim açık sayılır.
model NotificationPreference {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  type      String
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId])
  @@map("notification_preferences")
}

/// Kullanıcının aktif check-in'i (Sprint-7 #91).
/// 3 saat TTL — `expiresAt` ile lazy filtreleme (cron yok). Kullanıcı tek seferde
/// yalnızca bir aktif check-in tutar; yeni check-in eskisini siler.
/// ActivityEvent (CHECKIN) ayrıca yazılır; check-in expire olsa da geçmiş kayıt kalır.
model CheckIn {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  placeId   String   @map("place_id")
  placeName String   @map("place_name")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("check_ins")
}

/// Kullanıcının serbest metin arama geçmişi (Sprint-6 #87).
/// Son aramalar AI önerisinin sistem prompt'una "bu hafta 3x kebap aradı" şeklinde
/// enjekte edilir. KVKK için kullanıcı silebilir; admin değil.
model SearchHistory {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  query     String   @db.VarChar(200)
  type      String?  @db.VarChar(50) // 'free_text' | 'cuisine_tag' | null
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("search_history")
}

/// Haftalık cron'un ürettiği kullanıcı bazlı mutfak/restoran tipi tercih özeti (S4-7).
/// AI sistem prompt'una "X mutfağını beğeniyor, Y'yi beğenmiyor" sinyali olarak enjekte edilir.
model FeedbackPreference {
  userId        String   @id @map("user_id")
  likedTypes    String[] @default([]) @map("liked_types")
  dislikedTypes String[] @default([]) @map("disliked_types")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("feedback_preferences")
}

// ─── Notifications ────────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  type      String // FRIEND_REQUEST | INSTANT_DISCOUNT | LEVEL_UP | RECOMMENDATION | REVIEW_REPLY
  title     String
  body      String
  data      Json?
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

/// Kullanıcının platforma eklenmesini istediği restoran talebi (Sprint-8 #104).
/// Aynı kullanıcı aynı placeId için yalnızca bir talep oluşturabilir (unique).
/// Admin REVIEWED olarak işaretleyebilir.
model PlaceRequest {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  placeId      String   @map("place_id")
  placeName    String   @map("place_name")
  placeAddress String?  @map("place_address") @db.VarChar(300)
  note         String?  @db.VarChar(500)
  status       String   @default("PENDING") // PENDING | REVIEWED
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, placeId])
  @@index([status, createdAt])
  @@map("place_requests")
}

// Sprint-17 #366 — "Son baktığın restoranlar" için görüntüleme kaydı.
// Kullanıcı bir mekan detayını açtığında upsert edilir (userId+placeId tekil; en son
// viewedAt güncellenir). Place alanları denormalize tutulur ki "Son Baktıkların" rayı
// Google'a tekrar çağrı yapmadan render edilebilsin.
model PlaceView {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  placeId       String   @map("place_id")
  placeName     String   @map("place_name")
  placeAddress  String?  @map("place_address") @db.VarChar(300)
  placePhotoUrl String?  @map("place_photo_url")
  placeRating   Decimal? @map("place_rating") @db.Decimal(3, 1)
  placeTypes    String[] @default([]) @map("place_types")
  viewedAt      DateTime @default(now()) @map("viewed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, placeId])
  @@index([userId, viewedAt])
  @@map("place_views")
}
