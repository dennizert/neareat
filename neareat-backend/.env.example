# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/neareat_db"

# Redis
REDIS_URL="redis://localhost:6379"

# Firebase
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com

# Google Places API
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# Google Sign-In — mobil @react-native-google-signin'in webClientId'i.
# Backend Google OAuth idToken'ı bu audience ile doğrular (google-auth-library).
# Mobil config.ts'deki GOOGLE_WEB_CLIENT_ID ile birebir aynı olmalı.
GOOGLE_WEB_CLIENT_ID=1088498639612-651fnimrdrpu7h4rqetm8bdrqtoesbk7.apps.googleusercontent.com

# Google Play Android IAP
# Google Play Console → Setup → API access → Service account → JSON key
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
# Google Play Console → All apps → [uygulama adı] → package name
GOOGLE_PLAY_PACKAGE_NAME=com.eatlas.mobile

# Google Play RTDN (Real-time Developer Notifications) — Pub/Sub authenticated push.
# Pub/Sub push aboneliğini "authentication" ile kurun; audience webhook URL'iniz olur.
# Tanımlıysa /webhooks/google-play yalnızca Google imzalı bildirimleri işler (sahte bildirim/DoS engeli).
GOOGLE_PUBSUB_AUDIENCE=https://railway-up-production-6cdc.up.railway.app/webhooks/google-play
# (Opsiyonel) Pub/Sub push service account e-postası — token bu hesaba ait olmalı.
# GOOGLE_PUBSUB_SA_EMAIL=my-pubsub-pusher@my-project.iam.gserviceaccount.com

# iOS App Store IAP — varsayılan KAPALI.
# Sunucu-taraflı StoreKit 2 imza doğrulaması implemente edilene kadar /verify/appstore
# ucu istemciye GÜVENMEZ: kapalıyken 503, açıkken (doğrulama yokken) 501 döner.
# Gerçek doğrulama hazır olunca 'true' yapılır.
IOS_IAP_ENABLED=false

# AWS S3 — restoran/ürün fotoğraf depolama (S10-2)
# Bucket public-read (GetObject) + CORS(PUT); IAM kullanıcı PutObject/GetObject/DeleteObject
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=eu-central-1
AWS_S3_BUCKET=eatlas-restaurant-photos

# Email (Resend — https://resend.com)
# API key al: resend.com → API Keys → Create API Key
# Gönderici: resend.com → Domains → Add Domain → DNS kayıtlarını (SPF/DKIM) gir → doğrula
# ÖNEMLİ: onboarding@resend.dev yalnızca hesap sahibinin kendi adresine gönderir.
# Gerçek kullanıcılara mail için EMAIL_FROM'u doğrulanmış domainle ayarla.
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=Eatlas <noreply@eatlastr.com>
# E-posta linkleri (verify-email / reset-password) bu adrese döner; üretimde Railway domaini.
APP_BASE_URL=https://railway-up-production-6cdc.up.railway.app
# (Opsiyonel) Uygulama yüklü değilse e-posta ara sayfasının yönlendireceği mağaza linki.
# Varsayılan: GOOGLE_PLAY_PACKAGE_NAME'den Play Store linki üretilir.
# ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=com.eatlas.mobile

# Anthropic API (AI Yemek Önerisi Motoru)
# https://console.anthropic.com → Settings → API Keys
# Free user → Haiku 4.5, Premium → Sonnet 4.6 modeli kullanılır
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Hassas yazma uçlarında (yorum/mesaj) e-posta doğrulaması şartı (S13-3).
# Varsayılan KAPALI — mevcut/kapalı-test kullanıcılarını kilitlememek için.
# Mobil UX + (gerekirse) doğrulanmamış hesap backfill'i hazır olunca 'true' yap.
ENFORCE_EMAIL_VERIFICATION=false

# Security
# ─── Üretimde ZORUNLU (eksik/zayıfsa boot reddedilir — bkz. src/config/validateEnv.js) ───
# JWT imzalama anahtarı. En az 32 karakter, uzun rastgele bir değer kullanın.
JWT_SECRET=change-this-to-a-long-random-secret-min-32-chars
# E-posta doğrulama / şifre sıfırlama token'larını HMAC ile hash'lemek için.
# Üretimde ZORUNLU ve ayrı bir değer olmalı (JWT_SECRET'e düşmesine güvenmeyin). Min 32 karakter.
TOKEN_HASH_SECRET=change-this-to-a-long-random-secret-min-32-chars
# ─── Önerilen (eksikse boot uyarı verir, durmaz) ───
ADMIN_SEED_SECRET=change-this-to-a-long-random-secret
ALLOWED_ORIGINS=https://yourdomain.com

# App
# AI öneri + foto analizi gibi pahalı uçlara kullanıcı başına dakikalık limit
AI_RATE_LIMIT_PER_MIN=10
FREE_RADIUS_KM=5
PREMIUM_RADIUS_KM=25
FREE_FAVORITES_LIMIT=5
TRIAL_DAYS=7
# "Her zaman premium" hesaplar — virgülle ayrılmış e-posta listesi (opsiyonel).
# S13-4: kod-içi varsayılan YOK; yalnızca burada listelenen VE e-postası doğrulanmış
# (emailVerified) hesaplar premium sayılır. Boş bırakılırsa kimse otomatik premium olmaz.
ALWAYS_PREMIUM_EMAILS=
REDIS_NEARBY_TTL=3600
REDIS_PLACE_DETAILS_TTL=86400
