# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/neareat_db"

# Redis
REDIS_URL="redis://localhost:6379"

# Firebase
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com

# Google Places API
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# Google Play Android IAP
# Google Play Console → Setup → API access → Service account → JSON key
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
# Google Play Console → All apps → [uygulama adı] → package name
GOOGLE_PLAY_PACKAGE_NAME=com.eatlas.mobile

# AWS S3
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=eu-central-1
AWS_S3_BUCKET=neareat-uploads

# Email (Resend — https://resend.com)
# API key al: resend.com → API Keys → Create API Key
# Gönderici: resend.com → Domains → Add Email Address → e-postanı doğrula
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=NearEat <your-verified-email@gmail.com>

# Anthropic API (AI Yemek Önerisi Motoru)
# https://console.anthropic.com → Settings → API Keys
# Free user → Haiku 4.5, Premium → Sonnet 4.6 modeli kullanılır
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Security
ADMIN_SEED_SECRET=change-this-to-a-long-random-secret
ALLOWED_ORIGINS=https://yourdomain.com

# App
FREE_RADIUS_KM=5
PREMIUM_RADIUS_KM=25
FREE_FAVORITES_LIMIT=5
TRIAL_DAYS=7
REDIS_NEARBY_TTL=3600
REDIS_PLACE_DETAILS_TTL=86400
